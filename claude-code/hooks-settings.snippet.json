{
  "_comment": "Merge this into the top-level `hooks` key of ~/.claude/settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cmux_tab_title.sh",
            "timeout": 45,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cmux_tab_title.sh",
            "timeout": 45,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cmux_tab_title.sh --blank",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
